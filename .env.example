# Any long random string. n8n encrypts stored credentials with it.
N8N_ENCRYPTION_KEY=
# The secret the phone sends in the header X-Log-Key.
GAME_LOG_KEY=
# Optional: minutes without a reading that end a play session (default 30).
SESSION_GAP_MINUTES=
# Optional: fill in all three to switch the Google Sheets nodes on with a
# service account. Share the spreadsheet with that account's email as editor.
# The key goes on one line, with \n where the key file has line breaks.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Time zone of the n8n instance.
GENERIC_TIMEZONE=UTC
# Port of the n8n editor on this machine.
N8N_PORT=5678
